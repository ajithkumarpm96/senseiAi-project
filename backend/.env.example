# SenseiAI Backend Environment Variables
# Copy this to .env and fill in your values

# Security
SECRET_KEY=change-this-to-a-random-string
ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app

# Database (SQLite — just a file path)
DATABASE_URL=sqlite:///./sensei.db

# LLM Configuration
# Choose "groq" (Free, 1000+ requests/day, very fast) or "gemini"
LLM_PROVIDER=groq
GROQ_API_KEY=your-groq-api-key-here
LLM_MODEL=llama-3.3-70b-versatile

# Gemini Key (fallback / if LLM_PROVIDER=gemini)
GEMINI_API_KEY=your-gemini-api-key-here

# Guardrails
KILL_SWITCH=false
DAILY_TOKEN_LIMIT=500000
MONTHLY_TOKEN_LIMIT=10000000
PER_REQUEST_MAX_TOKENS=8000
RATE_LIMIT_PER_HOUR=20

# Debug
DEBUG=true
